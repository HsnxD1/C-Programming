/*
    Program: Check Whether a Number is Odd or Even
    Coder: Hasan Zaid

    Basic idea:
    - Take a number as input.
    - Use the modulus (%) operator.
    - If number % 2 is 0, the number is even.
    - Otherwise, the number is odd.
*/

#include <stdio.h>

int main()
{
    int num;

    printf("Enter a number: ");
    scanf("%d", &num);

    if (num % 2 == 0)
        printf("%d is Even", num);
    else
        printf("%d is Odd", num);

    return 0;
}
