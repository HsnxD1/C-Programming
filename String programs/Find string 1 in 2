
#include <stdio.h>
#include <string.h>

int main()
{
    char s[100], t[50];
    int i, j, found = -1;

    // Read main string and substring
    gets(s);
    gets(t);

    // Check every position in main string
    for(i = 0; s[i] != '\0'; i++)
    {
        // Compare substring characters
        for(j = 0; t[j] != '\0'; j++)
        {
            if(s[i + j] != t[j])
                break;  // Stop if characters don't match
        }

        // If entire substring matches
        if(t[j] == '\0')
        {
            found = i;
            break;
        }
    }

    // Display starting index or -1
    printf("Position = %d", found);

    return 0;
}
