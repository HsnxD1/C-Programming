
#include <stdio.h>
#include <string.h>

int main()
{
    char s[100];
    int pos, n, i;
    
// you can use "gets" instead of scanf

    printf("Enter string: ");
    scanf("%99s", s);

    printf("Enter position: ");
    scanf("%d", &pos);

    printf("Enter number of characters to delete: ");
    scanf("%d", &n);

    // Shift characters to the left
    for(i = pos; s[i + n] != '\0'; i++)
    {
        s[i] = s[i + n];
    }

    // End the new string
    s[i] = '\0';

    printf("Result: %s", s);

    return 0;
}

