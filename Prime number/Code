/*
    Program: Check Whether a Number is Prime
    Coder: Hasan Zaid

    Basic idea:
    - A prime number has exactly two factors: 1 and itself.
    - Check whether the number is divisible by any number
      from 2 up to num - 1.
    - If it is divisible, it is not prime.
*/

#include <stdio.h>

int main()
{
    int num, i, flag = 0;

    printf("Enter a number: ");
    scanf("%d", &num);

    if (num <= 1)
    {
        printf("%d is not a prime number.", num);
    }
    else
    {
        for (i = 2; i < num; i++)
        {
            if (num % i == 0)
            {
                flag = 1;
                break;
            }
        }

        if (flag == 0)
            printf("%d is a prime number.", num);
        else
            printf("%d is not a prime number.", num);
    }

    return 0;
}